{
  "name": "to-caption",
  "version": "1.3.0",
  "description": "Converts camelCase, PascalCase and delimited strings to captions",
  "type": "module",
  "main": "./dist/toCaption.js",
  "module": "./src/index.js",
  "types": "./dist/toCaption.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/toCaption.d.ts",
        "default": "./dist/toCaption.js"
      }
    },
    "./dist/toCaption.js": {
      "types": "./dist/toCaption.d.ts",
      "default": "./dist/toCaption.js"
    },
    "./src/index.js": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "changelog.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "webpack",
    "copyright": "node scripts/update-license.js && eslint . --fix",
    "lint": "eslint .",
    "test": "mocha",
    "check:types": "attw --pack . --exclude-entrypoints ./src/index.js",
    "check:homepage": "node scripts/check-homepage.js",
    "prepublishOnly": "npm run check:homepage && npm run copyright && npm run build && npm run lint && npm test && npm run check:types"
  },
  "keywords": [
    "label",
    "caption",
    "camelcase",
    "snakecase",
    "ui",
    "gui",
    "editor",
    "pascalcase",
    "kebabcase",
    "titlecase",
    "humanize",
    "acronym"
  ],
  "author": "Steven Spungin",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "babel-loader": "^10.1.1",
    "chai": "^6.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-headers": "^1.3.4",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-evolve/to-caption.git"
  },
  "bugs": "https://github.com/code-evolve/to-caption/issues",
  "homepage": "https://www.code-evolve.com/products/to-caption",
  "browserslist": "> 0.25%, not dead",
  "config": {
    "copyright": {
      "holder": "Steven Spungin",
      "startYear": 2016
    }
  }
}
